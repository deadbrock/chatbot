# Configurações do Servidor
# Se a porta estiver ocupada, o servidor tenta automaticamente PORT+1.
PORT=3000
NODE_ENV=development

# JWT (obrigatório em produção; em dev há fallback, mas recomenda-se configurar)
JWT_SECRET=dev_jwt_secret_change_me

# Configurações do WhatsApp
# WhatsApp / WPPConnect
WHATSAPP_SESSION_NAME=chatbot-session
WHATSAPP_TIMEOUT=0
WHATSAPP_DEVICE_SYNC_TIMEOUT=0
# Versão do WhatsApp Web (opcional; padrão 2.2412.54 no código)
# WHATSAPP_VERSION=2.2412.54
# Chrome roda em segundo plano (headless). O QR aparece no painel, sem abrir janela.
# WHATSAPP_HEADLESS=false
# Mensagens importadas por conversa na sincronização (padrão: 50)
# WHATSAPP_SYNC_MESSAGES_PER_CHAT=50
# WHATSAPP_SYNC_DELAY_MS=300
# WHATSAPP_DEVICE_NAME=AstroChat
# Caminho do Chrome (opcional — detectado automaticamente no Windows)
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Em produção (Railway), origens do frontend separadas por vírgula
# ALLOWED_ORIGINS=https://chatbot-three-bay.vercel.app,https://astrochat-rho.vercel.app
# Previews Vercel (*.vercel.app) são permitidos automaticamente se houver alguma URL vercel.app acima
# ALLOW_VERCEL_PREVIEWS=false  # desabilita previews se necessário

# Configurações de Atendimento
INACTIVITY_TIMEOUT=300000
AUTO_CLOSE_TICKET_HOURS=24

# Respostas automáticas do WhatsApp (boas-vindas, menus, IA, automações)
# true  = habilita fluxos automáticos e IA (recomendado com chave Groq)
# false = apenas recebe mensagens e encaminha ao painel (atendimento manual)
# Se omitido: respostas automáticas ATIVAS por padrão
# Desative apenas se quiser modo 100% manual:
# BOT_AUTO_REPLY=false

# IA — Groq (gratuito)
# Railway: pode usar GROQ_API_KEY ou GROK_API_KEY (nome da variável no painel)
GROQ_API_KEY=
# GROK_API_KEY=

# =========================================
# Banco de dados (Sequelize)
# =========================================
# LOCAL (dev): SQLite
# DB_DIALECT=sqlite

# RAILWAY / Postgres remoto (testar logins reais localmente):
# DB_DIALECT=postgres
# DATABASE_URL=postgresql://postgres:SENHA@HOST.railway.app:PORT/railway
# DB_SSL=true
# Obtenha DATABASE_URL em: Railway → PostgreSQL → Variables → DATABASE_URL

# Opções:
# - SQLite (dev): DB_DIALECT=sqlite
# - Postgres (prod): DB_DIALECT=postgres
DB_DIALECT=sqlite

# SQLite
# SQLITE_PATH=./database.sqlite

# Postgres (AWS RDS)
# Você pode usar DATABASE_URL OU as variáveis separadas abaixo.
# DATABASE_URL=postgres://USER:SENHA@HOST:5432/NOME_DO_BANCO
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Em muitos RDS o SSL é recomendado (true/false)
DB_SSL=false
